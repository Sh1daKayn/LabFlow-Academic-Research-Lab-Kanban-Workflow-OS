# ==============================================================================
# LabFlow Environment Configuration (.env)
# Copy this file to `.env` before configuring remote PostgreSQL or Docker.
# Never commit real `.env` credentials to Git.
# ==============================================================================

# 1. PostgreSQL Connection String (Optional for local single-host mode)
# - If UNSET: LabFlow saves all updates on the host running Next.js inside
#   `.data/labflow-state.json` (zero-config local server persistence).
# - If SET:   LabFlow persists all data in PostgreSQL via Prisma ORM for true
#   multi-device / cloud deployments (Vercel, Railway, VPS, or Docker).
#
# Local Docker Compose example:
# DATABASE_URL="postgresql://labflow:labflow_secret@localhost:5432/labflow_db?schema=public"
#
# Managed Cloud Postgres (Neon / Supabase / RDS) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# 2. Optional Custom Directory for Local JSON Persistence (default: ./.data)
# LABFLOW_DATA_DIR="./.data"

# 3. Admin PI Master Password & HMAC Session Secret
# LABFLOW_DEFAULT_ADMIN_PASSWORD="admin888"
# LABFLOW_SESSION_SECRET="replace-with-random-64-char-hex-secret"
